[mysqld]
plugin-maturity=gamma
plugin-load-add=DUCKDB=ha_duckdb.so
plugin-load-add=RUN_IN_DUCKDB=ha_duckdb.so
plugin-load-add=QUACK_BRIDGE_TEST=ha_duckdb.so
plugin-load-add=DUCKDB_LOAD_PARQUET=ha_duckdb.so
plugin-load-add=DUCKDB_LOAD_CSV=ha_duckdb.so
plugin-load-add=DUCKDB_LOAD_JSON=ha_duckdb.so
plugin-load-add=DUCKDB_EXPORT_PARQUET=ha_duckdb.so
plugin-load-add=DUCKDB_EXPORT_CSV=ha_duckdb.so
plugin-load-add=DUCKDB_EXPORT_JSON=ha_duckdb.so
plugin-load-add=DUCKDB_EXPORT_DATABASE=ha_duckdb.so
plugin-load-add=DUCKDB_CHECKPOINT=ha_duckdb.so
plugin-load-add=DUCKDB_ANALYZE=ha_duckdb.so
plugin-load-add=DUCKDB_FILE_SIZE=ha_duckdb.so
plugin-load-add=DUCKDB_SETTING=ha_duckdb.so
plugin-load-add=DUCKDB_LOADED_EXTENSIONS=ha_duckdb.so
duckdb-allow-run-in-duckdb=ON