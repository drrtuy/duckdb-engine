+unique_ptr<QuackMessage> QuackServer::AuthorizeStatement(DatabaseInstance &db, QuackConnection &connection,
+                                                         const string &sql, string &effective_sql) {
+	// TODO do not do this if there is no fun set
+	auto authz = EvaluateAuthQuery(
+	    db, StringUtil::Format("SELECT %s(?, ?)", GetSettingString(db, "quack_authorization_function")),
+	    Value(connection.connection_id), Value(sql));
+	if (authz.Denied()) {
+		return authz.Failure("Authorization");
+	}
+	effective_sql = (authz.value.type().id() == LogicalTypeId::VARCHAR) ? authz.value.GetValue<string>() : sql;
+	return nullptr;
+}
