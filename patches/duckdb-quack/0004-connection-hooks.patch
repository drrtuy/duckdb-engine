+unique_ptr<QuackMessage> QuackServer::AuthenticateConnection(DatabaseInstance &db, ConnectionRequestMessage &request,
+                                                             const string &connection_id) {
+	auto auth = EvaluateAuthQuery(
+	    db, StringUtil::Format("SELECT %s(?, ?, ?)", GetSettingString(db, "quack_authentication_function")),
+	    Value(connection_id), Value(request.AuthString()), Value(Token()));
+	if (auth.Denied()) {
+		return auth.Failure("Authentication");
+	}
+	return nullptr;
