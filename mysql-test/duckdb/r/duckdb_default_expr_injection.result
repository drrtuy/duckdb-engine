#
# An expression DEFAULT must not inject DuckDB SQL (companion to
# MDEV-40610, which only covers literal defaults).
#
# A literal default is escaped by get_field_default_for_duckdb()
# (doubling the quote). An expression default is forwarded verbatim from
# TABLE_SHARE::vcol_defs, which stores MariaDB's Item::print() output.
# Item::print() backslash-escapes a quote inside a function-argument
# string literal (\'), but the DuckDB tokenizer does not honor backslash
# escapes: it would close the generated literal early and parse the
# remainder as DuckDB SQL. Unsafe expression text is now refused and the
# default is omitted from DuckDB (MariaDB still supplies the value).
SET NAMES utf8mb4;
SELECT run_in_duckdb('DROP TABLE IF EXISTS injexpr.injected_marker');
run_in_duckdb('DROP TABLE IF EXISTS injexpr.injected_marker')
Success	
BOOLEAN	
[ Rows: 0]


CREATE USER expr_injection_user@localhost;
GRANT CREATE ON injexpr.* TO expr_injection_user@localhost;
connect  expr_injection, localhost, expr_injection_user,,injexpr;
SET NAMES utf8mb4;
SET sql_mode='';
# The crafted expression DEFAULT would append a DuckDB COPY (dollar-quoted
# path so Item::print does not mangle the filename) and a CREATE TABLE
# marker. The unsafe default is omitted, so no statement is injected.
CREATE TABLE t (id INT PRIMARY KEY,
c VARCHAR(200) DEFAULT (concat('a'')));COPY(SELECT 1)TO $$zz_expr_inj.csv$$;CREATE TABLE injected_marker(x INTEGER)--', ''))
) ENGINE=DuckDB CHARSET=utf8mb4|
Warnings:
Note	1105	DuckDB: unsafe expression default of column 'c' is not forwarded to DuckDB; MariaDB supplies the value
disconnect expr_injection;
connection default;
# No injected COPY ran: zz_expr_inj.csv must not exist anywhere under the vardir.
# No injected CREATE ran: injected_marker must not exist in DuckDB.
SELECT run_in_duckdb('SELECT count(*) AS injected_marker_count FROM information_schema.tables WHERE table_name=''injected_marker''');
run_in_duckdb('SELECT count(*) AS injected_marker_count FROM information_schema.tables WHERE table_name=''injected_marker''')
injected_marker_count	
BIGINT	
[ Rows: 1]
0


DROP TABLE t;
DROP USER expr_injection_user@localhost;
