SET @saved_sql_mode= @@SESSION.sql_mode;
SET SESSION sql_mode='';
SET NAMES utf8mb4;
CREATE TABLE concat_i (id INT PRIMARY KEY, a VARCHAR(100), b VARCHAR(100), c VARCHAR(100)) ENGINE=InnoDB CHARSET=utf8mb4;
CREATE TABLE concat_d (id INT PRIMARY KEY, a VARCHAR(100), b VARCHAR(100), c VARCHAR(100)) ENGINE=DuckDB CHARSET=utf8mb4;
INSERT INTO concat_i VALUES (1,'a','b','c'),(2,NULL,'b','c'),(3,'a',NULL,'c'),(4,'a','b',NULL),(5,NULL,NULL,NULL),(6,'','',''),(7,'x','','z'),(8,'é','字','');
INSERT INTO concat_d SELECT * FROM concat_i;
include/assert.inc [CONCAT must propagate a column NULL]
