CREATE TABLE concat_chunks (id INT PRIMARY KEY, a VARCHAR(20), b VARCHAR(20)) ENGINE=DuckDB CHARSET=utf8mb4;
SELECT run_in_duckdb('INSERT INTO test.concat_chunks SELECT i, CASE WHEN i%2=0 THEN NULL ELSE lpad(i::VARCHAR,4,''0'') END, CASE WHEN i%3=0 THEN NULL ELSE ''s'' END FROM range(1,5001) t(i)');
run_in_duckdb('INSERT INTO test.concat_chunks SELECT i, CASE WHEN i%2=0 THEN NULL ELSE lpad(i::VARCHAR,4,''0'') END, CASE WHEN i%3=0 THEN NULL ELSE ''s'' END FROM range(1,5001) t(i)')
Count	
BIGINT	
[ Rows: 1]
5000


SELECT COUNT(*) AS rows_total, SUM(CONCAT(a,b) IS NULL) AS null_rows, SUM((a IS NULL OR b IS NULL) <> (CONCAT(a,b) IS NULL)) AS wrong_nulls FROM concat_chunks;
rows_total	null_rows	wrong_nulls
5000	3333	0
SELECT COUNT(*) AS rows_filtered, SUM((a IS NULL OR b IS NULL) <> (CONCAT(a,b) IS NULL)) AS wrong_nulls FROM concat_chunks WHERE id%5=0;
rows_filtered	wrong_nulls
1000	0
SELECT SUM((a IS NULL) <> (CONCAT(a,'suffix') IS NULL)) AS wrong_suffix, SUM((a IS NULL) <> (CONCAT('prefix',a) IS NULL)) AS wrong_prefix, SUM((a IS NULL OR b IS NULL) <> (CONCAT('prefix',a,b,'suffix') IS NULL)) AS wrong_multiple FROM concat_chunks;
wrong_suffix	wrong_prefix	wrong_multiple
0	0	0
SELECT SUM(a IS NULL) AS input_nulls, SUM(CONCAT(a,'x') IS NULL) AS concat_nulls, SUM(a IS NULL) AS input_nulls_after FROM concat_chunks;
input_nulls	concat_nulls	input_nulls_after
2500	2500	2500
SELECT run_in_duckdb('SELECT concat(''a'',NULL) IS NULL AS strict_null, concat(NULL,NULL) IS NULL AS all_null, concat('''','''') = '''' AS empty_preserved, concat_ws('':'',''a'',NULL,''b'') AS ws_unchanged');
