include/master-slave.inc
[connection master]
connection master;
SET @save_commit_wait_count=@@GLOBAL.binlog_commit_wait_count;
SET @save_commit_wait_usec=@@GLOBAL.binlog_commit_wait_usec;
CREATE DATABASE mdev_42299_rpl CHARACTER SET utf8mb4;
connection slave;
connection slave;
include/stop_slave.inc
SET @save_parallel_threads=@@GLOBAL.slave_parallel_threads;
SET @save_parallel_mode=@@GLOBAL.slave_parallel_mode;
SET GLOBAL slave_parallel_threads=4;
SET GLOBAL slave_parallel_mode=conservative;
USE mdev_42299_rpl;
SET SESSION sql_log_bin=0;
CREATE TABLE t (id INT PRIMARY KEY, v INT, untouched VARCHAR(16)) ENGINE=DuckDB;
CREATE TABLE u (id INT PRIMARY KEY, v INT, untouched VARCHAR(16)) ENGINE=DuckDB;
SET SESSION sql_log_bin=1;
include/start_slave.inc
connection master;
USE mdev_42299_rpl;
SET SESSION sql_log_bin=0;
CREATE TABLE t (id INT PRIMARY KEY, v INT, untouched VARCHAR(16)) ENGINE=InnoDB;
CREATE TABLE u (id INT PRIMARY KEY, v INT, untouched VARCHAR(16)) ENGINE=InnoDB;
SET SESSION sql_log_bin=1;
INSERT INTO t VALUES (1,0,'keep-1'),(2,0,'keep-2'),(3,0,'keep-3'),(4,0,'keep-4');
INSERT INTO u SELECT * FROM t;
connection slave;
connection slave;
include/stop_slave_sql.inc
Conservative parallel replay of four-transaction commit groups
connect  writer1,localhost,root,,mdev_42299_rpl,$MASTER_MYPORT,$MASTER_MYSOCK;
connect  writer2,localhost,root,,mdev_42299_rpl,$MASTER_MYPORT,$MASTER_MYSOCK;
connect  writer3,localhost,root,,mdev_42299_rpl,$MASTER_MYPORT,$MASTER_MYSOCK;
connect  writer4,localhost,root,,mdev_42299_rpl,$MASTER_MYPORT,$MASTER_MYSOCK;
connection master;
SET GLOBAL binlog_commit_wait_count=4;
SET GLOBAL binlog_commit_wait_usec=1000000;
connection master;
SET GLOBAL binlog_commit_wait_count=@save_commit_wait_count;
SET GLOBAL binlog_commit_wait_usec=@save_commit_wait_usec;
connection slave;
START SLAVE SQL_THREAD;
include/stop_slave_sql.inc
SELECT * FROM t ORDER BY id;
id	v	untouched
129	32	keep-1
130	32	keep-2
131	32	keep-3
132	32	keep-4
SELECT * FROM u ORDER BY id;
id	v	untouched
1	32	keep-1
2	32	keep-2
3	32	keep-3
4	32	keep-4
include/diff_tables.inc [master:mdev_42299_rpl.t,slave:mdev_42299_rpl.t]
include/diff_tables.inc [master:mdev_42299_rpl.u,slave:mdev_42299_rpl.u]
connection slave;
START SLAVE SQL_THREAD;
CALL mtr.add_suppression("optimistic or aggressive parallel replication with this storage engine");
CALL mtr.add_suppression("Slave: Storage engine DUCKDB of the table `mdev_42299_rpl`.`t` doesn't have this option Error_code: 1031");
connection slave;
include/stop_slave_sql.inc
SET GLOBAL slave_parallel_mode=optimistic;
connection master;
BEGIN;
UPDATE t SET v=v+100 WHERE id=129;
UPDATE u SET v=v+100 WHERE id=1;
COMMIT;
connection slave;
Reject optimistic before changing either table
START SLAVE SQL_THREAD;
include/wait_for_slave_sql_error.inc [errno=1235]
