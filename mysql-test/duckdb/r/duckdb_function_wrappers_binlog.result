#
# The wrappers and run_in_duckdb() have side effects: statements calling
# them are unsafe for statement-based binlogging, so they are never
# replayed as text.
#
call mtr.add_suppression("Unsafe statement written to the binary log");
CREATE TABLE t (n BIGINT) ENGINE=InnoDB;
SET SESSION binlog_format= STATEMENT;
INSERT INTO t SELECT duckdb_file_size();
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
INSERT INTO t SELECT LENGTH(run_in_duckdb('SELECT 1'));
Warnings:
Note	1592	Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT. Statement is unsafe because it uses a system function that may return a different value on the slave
SET SESSION binlog_format= MIXED;
INSERT INTO t SELECT duckdb_file_size();
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
mysqld-bin.000001	#	Gtid	#	#	BEGIN GTID #-#-#
mysqld-bin.000001	#	Annotate_rows	#	#	INSERT INTO t SELECT duckdb_file_size()
mysqld-bin.000001	#	Table_map	#	#	table_id: # (test.t)
mysqld-bin.000001	#	Write_rows_v1	#	#	table_id: # flags: STMT_END_F
mysqld-bin.000001	#	Xid	#	#	COMMIT /* XID */
DROP TABLE t;
