# A password older than its lifetime is expired
UPDATE mysql.global_priv SET Priv= JSON_SET(Priv, '$.password_last_changed',
UNIX_TIMESTAMP() - 20 * 86400) WHERE User = 'aged' AND Host = 'localhost';
FLUSH PRIVILEGES;
