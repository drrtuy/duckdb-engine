# Counters, as changed by this test
SELECT LOWER(n.VARIABLE_NAME) AS name,
IF(n.VARIABLE_NAME = 'DUCKDB_QUACK_STATEMENTS', n.VARIABLE_VALUE - c.value > 20,
n.VARIABLE_VALUE - c.value) AS delta
FROM information_schema.global_status n JOIN quack_counters c ON c.name = n.VARIABLE_NAME
WHERE n.VARIABLE_NAME NOT IN ('DUCKDB_QUACK_RUNNING', 'DUCKDB_QUACK_ENDPOINTS',
'DUCKDB_QUACK_SSL_FINGERPRINT', 'DUCKDB_QUACK_SESSIONS')
ORDER BY name;
name	delta
duckdb_quack_acl_timeouts	2
duckdb_quack_connections_refused	0
duckdb_quack_limit_refusals	1
duckdb_quack_logins	24
duckdb_quack_logins_refused	18
duckdb_quack_sessions_evicted	0
duckdb_quack_statements	1
duckdb_quack_statements_refused	7
DROP TEMPORARY TABLE quack_counters;
# Every session was closed
SET GLOBAL log_warnings= @saved_log_warnings;
DROP USER alice@localhost, colin@localhost, locked@localhost, expired@localhost,
x509@localhost, other@localhost, rolly@localhost, carol@localhost,
sslu@localhost, nopw@localhost, aged@localhost, lim@localhost;
DROP ROLE reader;
DROP DATABASE qs;
