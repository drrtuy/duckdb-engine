#
# MDEV-41383: Quack clients log in as MariaDB accounts and read only
# what their grants allow
#
call mtr.add_suppression("DuckDB: Quack login refused");
call mtr.add_suppression("DuckDB: Quack statement refused");
SET @saved_log_warnings= @@GLOBAL.log_warnings;
SET GLOBAL log_warnings= 2;
listening	fingerprint
1	1
CREATE DATABASE qs;
CREATE TABLE qs.t (id INT PRIMARY KEY, name VARCHAR(10), secret VARCHAR(10)) ENGINE=DuckDB;
INSERT INTO qs.t VALUES (1, 'apple', 's1'), (2, 'bread', 's2');
CREATE TABLE qs.hidden (id INT PRIMARY KEY) ENGINE=DuckDB;
CREATE USER alice@localhost IDENTIFIED BY 'pw';
GRANT SELECT ON qs.t TO alice@localhost;
CREATE USER colin@localhost IDENTIFIED BY 'pw';
GRANT SELECT (id, name) ON qs.t TO colin@localhost;
CREATE USER locked@localhost IDENTIFIED BY 'pw' ACCOUNT LOCK;
GRANT SELECT ON qs.t TO locked@localhost;
CREATE USER expired@localhost IDENTIFIED BY 'pw' PASSWORD EXPIRE;
GRANT SELECT ON qs.t TO expired@localhost;
CREATE USER x509@localhost IDENTIFIED BY 'pw' REQUIRE X509;
GRANT SELECT ON qs.t TO x509@localhost;
CREATE USER other@localhost IDENTIFIED VIA mysql_native_password USING PASSWORD('pw') OR mysql_native_password USING PASSWORD('pw2');
GRANT SELECT ON qs.t TO other@localhost;
CREATE USER sslu@localhost IDENTIFIED BY 'pw' REQUIRE SSL;
GRANT SELECT ON qs.t TO sslu@localhost;
CREATE USER nopw@localhost;
GRANT SELECT ON qs.t TO nopw@localhost;
CREATE USER aged@localhost IDENTIFIED BY 'pw' PASSWORD EXPIRE INTERVAL 10 DAY;
GRANT SELECT ON qs.t TO aged@localhost;
CREATE USER lim@localhost IDENTIFIED BY 'pw' WITH MAX_USER_CONNECTIONS 1;
GRANT SELECT ON qs.t TO lim@localhost;
CREATE ROLE reader;
GRANT SELECT ON qs.t TO reader;
CREATE USER rolly@localhost IDENTIFIED BY 'pw';
GRANT reader TO rolly@localhost;
SET DEFAULT ROLE reader FOR rolly@localhost;
CREATE USER carol@localhost IDENTIFIED BY 'pw';
GRANT SELECT ON qs.t TO carol@localhost;
