# A constant in the skipped hour
SET time_zone = '+00:00';
INSERT INTO tr VALUES (9, '2024-03-31 00:59:59'), (10, '2024-03-31 01:00:00');
INSERT INTO rr VALUES (9, '2024-03-31 00:59:59'), (10, '2024-03-31 01:00:00');
SET time_zone = 'MET';
# Rows: = <> < >= IN
SELECT GROUP_CONCAT(id ORDER BY id) AS r FROM tr WHERE ts = '2024-03-31 02:30:00'
  UNION ALL SELECT GROUP_CONCAT(id ORDER BY id) FROM tr WHERE ts <> '2024-03-31 02:30:00' AND id > 8
UNION ALL SELECT GROUP_CONCAT(id ORDER BY id) FROM tr WHERE ts < '2024-03-31 02:30:00' AND id > 8
UNION ALL SELECT GROUP_CONCAT(id ORDER BY id) FROM tr WHERE ts >= '2024-03-31 02:30:00' AND id > 8
UNION ALL SELECT GROUP_CONCAT(id ORDER BY id) FROM tr WHERE ts IN ('2024-03-31 02:30:00');
