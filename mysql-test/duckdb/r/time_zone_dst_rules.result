CREATE DATABASE test_duckdb;
USE test_duckdb;
CREATE TABLE t (id INT PRIMARY KEY, ts TIMESTAMP NULL, dt DATETIME) ENGINE = DuckDB;
CREATE TABLE r (id INT PRIMARY KEY, ts TIMESTAMP NULL, dt DATETIME) ENGINE = InnoDB;
SET time_zone = 'MET';
INSERT INTO t VALUES (1, '2024-10-27 02:30:00', '2024-10-27 02:30:00'),
(2, '2024-03-31 03:00:00', '2024-03-31 02:30:00'),
(3, '2024-10-27 01:30:00', '2024-10-27 03:00:00');
INSERT INTO r VALUES (1, '2024-10-27 02:30:00', '2024-10-27 02:30:00'),
(2, '2024-03-31 03:00:00', '2024-03-31 02:30:00'),
(3, '2024-10-27 01:30:00', '2024-10-27 03:00:00');
# String literal in the repeated hour
SELECT id FROM t WHERE ts = '2024-10-27 02:30:00';
id
1
SELECT id FROM r WHERE ts = '2024-10-27 02:30:00';
id
1
SELECT id FROM t WHERE ts BETWEEN '2024-10-27 02:00:00' AND '2024-10-27 02:59:59' ORDER BY id;
id
1
SELECT id FROM r WHERE ts BETWEEN '2024-10-27 02:00:00' AND '2024-10-27 02:59:59' ORDER BY id;
id
1
# TIMESTAMP literal
SELECT id FROM t WHERE ts = TIMESTAMP'2024-10-27 02:30:00' ORDER BY id;
id
1
SELECT id FROM r WHERE ts = TIMESTAMP'2024-10-27 02:30:00' ORDER BY id;
id
1
SELECT id FROM t WHERE ts = CAST('2024-10-27 02:30:00' AS DATETIME) ORDER BY id;
id
1
SELECT id FROM r WHERE ts = CAST('2024-10-27 02:30:00' AS DATETIME) ORDER BY id;
id
1
# TIMESTAMP compared with DATETIME
SELECT id FROM t WHERE ts = dt ORDER BY id;
id
1
SELECT id FROM r WHERE ts = dt ORDER BY id;
id
1
SELECT id FROM t WHERE ts < dt ORDER BY id;
id
3
SELECT id FROM r WHERE ts < dt ORDER BY id;
id
3
# An explicit offset in the string is kept
SELECT id FROM t WHERE ts = '2024-10-27 00:30:00+00:00';
id
1
# CONVERT_TZ: MariaDB names, offsets, skipped and repeated hours
SELECT id, CONVERT_TZ(dt, 'MET', 'UTC') AS a, CONVERT_TZ(dt, 'MET', '+05:30') AS b,
CONVERT_TZ(dt, 'UTC', 'MET') AS c, CONVERT_TZ(dt, 'MET', 'No/Such_Zone') AS d FROM t ORDER BY id;
id	a	b	c	d
1	2024-10-27 00:30:00	2024-10-27 06:00:00	2024-10-27 03:30:00	NULL
2	2024-03-31 01:00:00	2024-03-31 06:30:00	2024-03-31 04:30:00	NULL
3	2024-10-27 02:00:00	2024-10-27 07:30:00	2024-10-27 04:00:00	NULL
SELECT id, CONVERT_TZ(dt, 'MET', 'UTC') AS a, CONVERT_TZ(dt, 'MET', '+05:30') AS b,
CONVERT_TZ(dt, 'UTC', 'MET') AS c, CONVERT_TZ(dt, 'MET', 'No/Such_Zone') AS d FROM r ORDER BY id;
id	a	b	c	d
1	2024-10-27 00:30:00	2024-10-27 06:00:00	2024-10-27 03:30:00	NULL
2	2024-03-31 01:00:00	2024-03-31 06:30:00	2024-03-31 04:30:00	NULL
3	2024-10-27 02:00:00	2024-10-27 07:30:00	2024-10-27 04:00:00	NULL
SELECT id, CONVERT_TZ('1970-01-01 00:30:00', 'MET', 'UTC') AS out_of_range,
CONVERT_TZ(ts, 'MET', 'UTC') AS from_ts,
CONVERT_TZ('2024-03-31 02:30:00.25', 'MET', 'UTC') AS skipped_fraction,
CONVERT_TZ(dt, '+13:00', 'UTC') AS max_offset, CONVERT_TZ(dt, '+13:01', 'UTC') AS bad_offset,
CONVERT_TZ(dt, '+ 5:30', 'UTC') AS bad_format FROM t ORDER BY id;
id	out_of_range	from_ts	skipped_fraction	max_offset	bad_offset	bad_format
1	1970-01-01 00:30:00	2024-10-27 00:30:00	2024-03-31 01:00:00.25	2024-10-26 13:30:00	NULL	NULL
2	1970-01-01 00:30:00	2024-03-31 01:00:00	2024-03-31 01:00:00.25	2024-03-30 13:30:00	NULL	NULL
3	1970-01-01 00:30:00	2024-10-26 23:30:00	2024-03-31 01:00:00.25	2024-10-26 14:00:00	NULL	NULL
SELECT id, CONVERT_TZ('1970-01-01 00:30:00', 'MET', 'UTC') AS out_of_range,
CONVERT_TZ(ts, 'MET', 'UTC') AS from_ts,
CONVERT_TZ('2024-03-31 02:30:00.25', 'MET', 'UTC') AS skipped_fraction,
CONVERT_TZ(dt, '+13:00', 'UTC') AS max_offset, CONVERT_TZ(dt, '+13:01', 'UTC') AS bad_offset,
CONVERT_TZ(dt, '+ 5:30', 'UTC') AS bad_format FROM r ORDER BY id;
