# Sessions that are not MariaDB's (run_in_duckdb opens its own
# connection, like a Quack client) keep DuckDB's cast: 02:30 in the
# skipped hour is 01:30 UTC there, 01:00 UTC under MariaDB's rules
SELECT run_in_duckdb("SET TimeZone = 'MET'; SELECT epoch(x::TIMESTAMPTZ)::BIGINT AS e FROM (VALUES (TIMESTAMP '2024-03-31 02:30:00')) v(x)") AS duckdb_rules;
duckdb_rules
e	
BIGINT	
[ Rows: 1]
1711848600


SELECT run_in_duckdb("SET TimeZone = 'MET'; SET VARIABLE mariadb_tz_rules = true; SELECT epoch(x::TIMESTAMPTZ)::BIGINT AS e FROM (VALUES (TIMESTAMP '2024-03-31 02:30:00')) v(x)") AS mariadb_rules;
