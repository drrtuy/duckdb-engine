ALTER TABLE peg_t ADD COLUMN `after"error` INT DEFAULT 7;
UPDATE peg_t SET `after"error` = 8 WHERE id = 1;
SELECT id, `after"error` FROM peg_t ORDER BY id;
id	after"error
1	8
2	7
3	7
ALTER TABLE peg_t ADD COLUMN `norm space` INT DEFAULT 1;
normalization_safe
6
connect  peg_other, localhost, root,,test;
SET SESSION sql_mode = 'ANSI_QUOTES,NO_BACKSLASH_ESCAPES';
SELECT CONVERT /* other */ (id, CHAR) AS "converted" FROM peg_t ORDER BY id LIMIT 0,1;
converted
1
connection default;
SELECT CONVERT /* original */ (id, CHAR) AS converted FROM peg_t ORDER BY id LIMIT 2,1;
converted
3
connection peg_other;
SELECT id AS "id" FROM peg_t ORDER BY id LIMIT 1,1;
id
2
disconnect peg_other;
connection default;
CREATE USER peg_column_user@localhost;
GRANT SELECT(id) ON test.peg_t TO peg_column_user@localhost;
connect  peg_acl, localhost, peg_column_user,,test;
