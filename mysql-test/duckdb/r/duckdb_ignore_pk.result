# A column standing before a key column is dropped by a table rebuild:
# DuckDB indexes address columns by position
CREATE TABLE pk_drop (a INT, b INT, c INT, d INT, e INT, PRIMARY KEY (d, b)) ENGINE=DuckDB;
INSERT INTO pk_drop VALUES (1, 2, 3, 4, 5);
ALTER TABLE pk_drop DROP COLUMN a, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported for this operation. Try ALGORITHM=COPY
ALTER TABLE pk_drop DROP COLUMN e, ALGORITHM=INPLACE;
ALTER TABLE pk_drop DROP COLUMN a;
ALTER TABLE pk_drop DROP COLUMN c;
SELECT * FROM pk_drop;
b	d
2	4
INSERT INTO pk_drop VALUES (2, 4);
ERROR HY000: Got error 168 'Constraint Error: Duplicate key "d: 4, b: 2" violates primary key constraint.' from DuckDB
