#
# Case- and accent-insensitive key columns: a DuckDB PRIMARY KEY compares
# bytes, so a unique expression index enforces the key instead.
#
SET NAMES utf8mb4;
CREATE TABLE pk_ci (id VARCHAR(20) PRIMARY KEY, v INT) ENGINE=DuckDB CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
INSERT INTO pk_ci VALUES ('a', 1);
INSERT INTO pk_ci VALUES ('A', 2);
ERROR HY000: Got error 168 'Constraint Error: Duplicate key "lower(strip_accents(id)): a" violates unique constraint.' from DuckDB
INSERT INTO pk_ci VALUES ('á', 3);
ERROR HY000: Got error 168 'Constraint Error: Duplicate key "lower(strip_accents(id)): a" violates unique constraint.' from DuckDB
SELECT * FROM pk_ci;
id	v
a	1
SELECT run_in_duckdb("SELECT index_name, table_name, is_unique, expressions FROM duckdb_indexes() WHERE schema_name='test' ORDER BY index_name");
run_in_duckdb("SELECT index_name, table_name, is_unique, expressions FROM duckdb_indexes() WHERE schema_name='test' ORDER BY index_name")
index_name	table_name	is_unique	expressions	
VARCHAR	VARCHAR	BOOLEAN	VARCHAR	
[ Rows: 1]
mdb_pk_pk_ci	pk_ci	true	['(lower(strip_accents(id)))']


SELECT run_in_duckdb("SELECT count(*) AS pk_count FROM duckdb_constraints() WHERE schema_name='test' AND table_name='pk_ci' AND constraint_type='PRIMARY KEY'");
run_in_duckdb("SELECT count(*) AS pk_count FROM duckdb_constraints() WHERE schema_name='test' AND table_name='pk_ci' AND constraint_type='PRIMARY KEY'")
pk_count	
BIGINT	
[ Rows: 1]
