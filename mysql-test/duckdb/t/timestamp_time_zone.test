--source ../include/have_duckdb.inc

# TIMESTAMP is an instant. DuckDB keeps it in a TIMESTAMPTZ column, so
# both write paths (batch appender and SQL) must store the instant, and
# reads must show it in the reader's time_zone. Every DuckDB result below
# must match the InnoDB reference table.

CREATE DATABASE test_duckdb;
USE test_duckdb;
CREATE TABLE t (id INT PRIMARY KEY, ts TIMESTAMP(6) NULL) ENGINE = DuckDB;
CREATE TABLE ref (id INT PRIMARY KEY, ts TIMESTAMP(6) NULL) ENGINE = InnoDB;

SET time_zone = '+02:00';
SET GLOBAL duckdb_dml_in_batch = ON;
INSERT INTO t VALUES (1, '2024-01-01 00:00:00'), (2, '2024-07-01 12:34:56.789');
SET GLOBAL duckdb_dml_in_batch = OFF;
INSERT INTO t VALUES (3, '2024-01-01 00:00:00'), (4, '2024-07-01 12:34:56.789'), (5, NULL);
INSERT INTO ref VALUES (1, '2024-01-01 00:00:00'), (2, '2024-07-01 12:34:56.789'),
  (3, '2024-01-01 00:00:00'), (4, '2024-07-01 12:34:56.789'), (5, NULL);

--echo # Same zone
SELECT id, ts FROM t ORDER BY id;
SELECT id, ts FROM ref ORDER BY id;

--echo # Another zone: pushed down, then through the handler (a user
--echo # variable stops pushdown). Pushed-down UNIX_TIMESTAMP() returns whole
--echo # seconds, so it is only compared on whole-second rows.
SET time_zone = '-05:00';
SELECT id, ts FROM t ORDER BY id;
SELECT id, ts, @nopush := 1 AS np FROM t ORDER BY id;
SELECT id, ts FROM ref ORDER BY id;
SELECT id, UNIX_TIMESTAMP(ts) FROM t WHERE id IN (1, 3, 5) ORDER BY id;
SELECT id, UNIX_TIMESTAMP(ts) FROM ref WHERE id IN (1, 3, 5) ORDER BY id;

--echo # Cross-engine: InnoDB instants must equal DuckDB instants
SELECT t.id FROM t JOIN ref ON ref.id = t.id AND ref.ts = t.ts ORDER BY t.id;

--echo # UPDATE in both modes
SET GLOBAL duckdb_dml_in_batch = ON;
UPDATE t SET ts = '2024-03-01 10:00:00' WHERE id = 1;
SET GLOBAL duckdb_dml_in_batch = OFF;
UPDATE t SET ts = '2024-03-01 10:00:00' WHERE id = 3;
UPDATE ref SET ts = '2024-03-01 10:00:00' WHERE id IN (1, 3);
SET time_zone = '+00:00';
SELECT id, ts FROM t WHERE id IN (1, 3) ORDER BY id;
SELECT id, ts FROM ref WHERE id IN (1, 3) ORDER BY id;

--echo # Clocks going back: 02:30 MET happens twice on 2024-10-27.
--echo # MariaDB picks one instant; DuckDB must store that one.
SET time_zone = 'MET';
SET GLOBAL duckdb_dml_in_batch = ON;
INSERT INTO t VALUES (6, '2024-10-27 02:30:00');
SET GLOBAL duckdb_dml_in_batch = OFF;
INSERT INTO t VALUES (7, '2024-10-27 02:30:00');
INSERT INTO ref VALUES (6, '2024-10-27 02:30:00'), (7, '2024-10-27 02:30:00');
SET time_zone = '+00:00';
SELECT id, ts FROM t WHERE id > 5 ORDER BY id;
SELECT id, ts FROM ref WHERE id > 5 ORDER BY id;

--echo # A TIMESTAMPTZ result read into DATETIME fields: the session's
--echo # wall-clock time
CREATE TABLE d (id INT PRIMARY KEY, ts TIMESTAMP NULL, dt DATETIME) ENGINE = DuckDB;
CREATE TABLE dref (id INT PRIMARY KEY, ts TIMESTAMP NULL, dt DATETIME) ENGINE = InnoDB;
SET time_zone = '+02:00';
INSERT INTO d VALUES (1, '2024-01-01 00:30:00', '2000-01-01 00:00:00'), (2, NULL, '2000-01-01 00:00:00');
INSERT INTO dref VALUES (1, '2024-01-01 00:30:00', '2000-01-01 00:00:00'), (2, NULL, '2000-01-01 00:00:00');
SET time_zone = '+05:00';
SELECT id, COALESCE(ts, dt) AS c FROM d ORDER BY id;
SELECT id, COALESCE(ts, dt) AS c FROM dref ORDER BY id;

--echo # The zero TIMESTAMP, written both ways
SET sql_mode = '';
SET GLOBAL duckdb_dml_in_batch = ON;
INSERT INTO t VALUES (8, '0000-00-00 00:00:00');
SET GLOBAL duckdb_dml_in_batch = OFF;
INSERT INTO t VALUES (9, '0000-00-00 00:00:00');
INSERT INTO ref VALUES (8, '0000-00-00 00:00:00'), (9, '0000-00-00 00:00:00');
SELECT id, ts, UNIX_TIMESTAMP(ts) FROM t WHERE id > 7 ORDER BY id;
SELECT id, ts, UNIX_TIMESTAMP(ts) FROM ref WHERE id > 7 ORDER BY id;
SELECT t.id FROM t JOIN ref ON ref.id = t.id AND ref.ts = t.ts WHERE t.id > 7 ORDER BY t.id;
--echo # ... and read into a DATETIME result
INSERT INTO d VALUES (3, '0000-00-00 00:00:00', '2000-01-01 00:00:00');
INSERT INTO dref VALUES (3, '0000-00-00 00:00:00', '2000-01-01 00:00:00');
SELECT id, COALESCE(ts, dt) AS c FROM d WHERE id = 3;
SELECT id, COALESCE(ts, dt) AS c FROM dref WHERE id = 3;

--echo # A cross-engine filter on an InnoDB TIMESTAMP reads its literal in
--echo # the session zone (+05:00), not the global one
SELECT t.id FROM t JOIN ref ON ref.id = t.id
  WHERE ref.ts > '2024-03-01 18:00:00' AND t.id < 5 ORDER BY t.id;
SELECT id FROM ref WHERE ts > '2024-03-01 18:00:00' AND id < 5 ORDER BY id;
SET sql_mode = DEFAULT;

SET GLOBAL duckdb_dml_in_batch = DEFAULT;
SET time_zone = DEFAULT;
DROP DATABASE test_duckdb;
