--source ../include/have_duckdb.inc

#
# MDEV-40868 SIGABRT in duckdb::Value::CastAs on UNION of DuckDB
# and InnoDB table.  Invalid DATETIME '0000-00-00' used to throw
# out of select_to_duckdb::send_data and abort the server.
# The conversion error must be reported to the client instead of
# crashing the server or silently returning an empty result.
#

call mtr.add_suppression("FIBER: execution error");

CREATE TABLE t1 (c2 DATETIME) ENGINE=InnoDB;
INSERT INTO t1 VALUES ('0000-00-00');
CREATE TABLE t2 (c1 INT PRIMARY KEY) ENGINE=DuckDB;

--error ER_GET_ERRMSG
SELECT * FROM t2 UNION SELECT * FROM t1;

SET SESSION duckdb_cross_engine_ryow=1;
--error ER_GET_ERRMSG
SELECT * FROM t2 UNION SELECT * FROM t1;
SET SESSION duckdb_cross_engine_ryow=DEFAULT;

# Server must still be usable after the conversion error.
SELECT 1 AS still_alive;

# The direct (RYOW) scan of the InnoDB table must also be closed when
# DuckDB stops reading it before the end.  A scan left open only trips
# an assertion at unlock, so this case guards debug servers.
CREATE TABLE t3 (a INT) ENGINE=InnoDB;
INSERT INTO t3 WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 100) SELECT a.n FROM s a, s b;
SET SESSION duckdb_cross_engine_ryow=1;
SELECT COUNT(*) FROM (SELECT * FROM t2 UNION ALL SELECT * FROM t3 LIMIT 3) d;
SET SESSION duckdb_cross_engine_ryow=DEFAULT;
DROP TABLE t3;

DROP TABLE t2;
DROP TABLE t1;
