--source ../include/have_duckdb.inc

# The server runs with TZ=Europe/Paris (CET/CEST), which has summer time.
# Europe/Paris has the same offsets and DST transitions as MET but, unlike
# the legacy MET name, ships in the base tzdata of every distro (MET lives
# in tzdata-legacy and is absent on Debian 13 and other modern systems,
# where it would silently fall back to UTC). Under time_zone=SYSTEM DuckDB
# must use the zone's rules, not today's offset.

CREATE DATABASE test_duckdb;
USE test_duckdb;
CREATE TABLE t (id INT PRIMARY KEY, dt DATETIME) ENGINE = DuckDB;
INSERT INTO t VALUES (1, '2024-01-01 00:00:00'), (2, '2024-07-01 00:00:00');

SET time_zone = SYSTEM;
# @@system_time_zone is the libc abbreviation at server start: CET in
# winter, CEST in summer. Normalize so the result is season-independent.
--replace_regex /CEST/CET/
SELECT @@system_time_zone;
SELECT id, UNIX_TIMESTAMP(dt) FROM t ORDER BY id;

--echo # DST gap and repeated hour: MariaDB first, then pushed down
let $args = UNIX_TIMESTAMP('2024-03-31 02:30:00') AS gap,
  UNIX_TIMESTAMP('2024-10-27 02:30:00') AS twice;
--disable_warnings
eval SELECT $args;
--enable_warnings
eval SELECT $args FROM t WHERE id = 1;

SET time_zone = DEFAULT;
DROP DATABASE test_duckdb;
