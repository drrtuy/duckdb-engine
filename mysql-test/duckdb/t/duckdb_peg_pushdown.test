--disable_query_log
SET @saved_sql_mode = @@SESSION.sql_mode;
SET SESSION sql_mode = '';
SET NAMES utf8mb4;
--enable_query_log

CREATE TABLE peg_t (id INT PRIMARY KEY, v VARCHAR(30)) ENGINE=DuckDB DEFAULT CHARSET=utf8mb4;
INSERT INTO peg_t VALUES (1, 'a'), (2, 'b'), (3, 'a');
SELECT id, v FROM peg_t WHERE v = "a" ORDER BY id;
SET SESSION sql_mode = 'NO_BACKSLASH_ESCAPES';
SELECT id, v FROM peg_t WHERE v = "a" ORDER BY id;
SET SESSION sql_mode = '';

SELECT CONVERT('a,b', CHAR) AS converted FROM peg_t ORDER BY id LIMIT 1;
SELECT CONVERT /* function */ (id, CHAR) AS converted FROM peg_t ORDER BY id LIMIT 1,2;
SELECT id FROM peg_t WHERE v /* operand */ NOT /* operator */ RLIKE /* pattern */ 'b' ORDER BY id;
SELECT SQL_NO_CACHE STRAIGHT_JOIN a.id, b.v FROM peg_t a
STRAIGHT_JOIN peg_t b ON a.id=b.id ORDER BY a.id LIMIT 1,2;
SELECT id FROM peg_t FORCE INDEX FOR JOIN (PRIMARY) ORDER BY id LIMIT 1,2;
--sorted_result
SELECT v, COUNT(*) AS n FROM peg_t GROUP BY v WITH ROLLUP;
SELECT * FROM (SELECT id FROM peg_t ORDER BY id LIMIT 0,2) s ORDER BY id LIMIT 1,1;
SELECT 'STRAIGHT_JOIN CONVERT(x,y) LIMIT 1,2' AS literal FROM peg_t ORDER BY id LIMIT 1;
SELECT CURRENT_DATE() = CURRENT_DATE AS same_date,
CURRENT_TIME(3) IS NOT NULL AS has_time, CURRENT_TIMESTAMP(6) IS NOT NULL AS has_timestamp
FROM peg_t ORDER BY id LIMIT 1;

CREATE TABLE peg_i (id INT PRIMARY KEY, v VARCHAR(30)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
INSERT INTO peg_i VALUES (1, 'x'), (2, 'y');
SELECT CONVERT /* source */ (d.id, CHAR) AS id, i.v
FROM peg_t d JOIN peg_i i ON d.id=i.id ORDER BY d.id LIMIT 0,2;
--error ER_GET_ERRMSG
SELECT GROUP_CONCAT(i.v SEPARATOR ':') FROM peg_t d JOIN peg_i i ON d.id=i.id;
SELECT COUNT(*) AS restored_after_error FROM peg_t d JOIN peg_i i ON d.id=i.id;
SELECT CONVERT /* source */ (id, CHAR) AS id FROM peg_t
UNION ALL SELECT CONVERT(id, CHAR) AS id FROM peg_i ORDER BY id LIMIT 1,3;

CREATE TABLE peg_dest (v VARCHAR(30)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
INSERT INTO peg_dest SELECT CONVERT /* source */ (id, CHAR) FROM peg_t ORDER BY id LIMIT 1,2;
SELECT * FROM peg_dest ORDER BY v;

--error ER_GET_ERRMSG
SELECT CONVERT(v, UNSIGNED) FROM peg_t;
--error ER_GET_ERRMSG
SELECT GROUP_CONCAT(v SEPARATOR ':') FROM peg_t;
ALTER TABLE peg_t ADD COLUMN `after"error` INT DEFAULT 7;
UPDATE peg_t SET `after"error` = 8 WHERE id = 1;
SELECT id, `after"error` FROM peg_t ORDER BY id;
ALTER TABLE peg_t ADD COLUMN `norm space` INT DEFAULT 1;
--disable_query_log
let $normalization_ddl= `SELECT CONCAT('ALTER TABLE peg_t ADD COLUMN ', CHAR(96), 'norm', CONVERT(0xC2A0 USING utf8mb4), 'space', CHAR(96), ' INT DEFAULT 2')`;
eval $normalization_ddl;
let $normalization_select= `SELECT CONCAT('SELECT SUM(', CHAR(96), 'norm', CONVERT(0xC2A0 USING utf8mb4), 'space', CHAR(96), ') AS normalization_safe FROM peg_t')`;
eval $normalization_select;
--enable_query_log

connect (peg_other, localhost, root,,test);
SET SESSION sql_mode = 'ANSI_QUOTES,NO_BACKSLASH_ESCAPES';
SELECT CONVERT /* other */ (id, CHAR) AS "converted" FROM peg_t ORDER BY id LIMIT 0,1;
connection default;
SELECT CONVERT /* original */ (id, CHAR) AS converted FROM peg_t ORDER BY id LIMIT 2,1;
connection peg_other;
SELECT id AS "id" FROM peg_t ORDER BY id LIMIT 1,1;
disconnect peg_other;
connection default;

CREATE USER peg_column_user@localhost;
GRANT SELECT(id) ON test.peg_t TO peg_column_user@localhost;
connect (peg_acl, localhost, peg_column_user,,test);
SET SESSION sql_mode = '';
let $literal_value= query_get_value(SELECT "v" AS literal FROM peg_t, literal, 1);
let $assert_text= Default-mode double quotes must not read an unauthorized column;
let $assert_cond= "$literal_value" = "v";
--source include/assert.inc
SELECT "v" AS literal FROM peg_t;
SELECT REPEAT('a',5) AS $$ FROM peg_t # $$ WHERE 0 UNION ALL SELECT v FROM peg_t
;
SET SESSION sql_mode = 'NO_BACKSLASH_ESCAPES';
SELECT REPEAT('a',5) AS $$ FROM peg_t # $$ WHERE 0 UNION ALL SELECT v FROM peg_t
;
SET SESSION sql_mode = 'ANSI_QUOTES';
--error ER_COLUMNACCESS_DENIED_ERROR
SELECT "v" FROM peg_t;
SELECT "id" FROM peg_t;
SELECT REPEAT('a',5) AS $$ FROM peg_t # $$ WHERE 0 UNION ALL SELECT v FROM peg_t
;
SET SESSION sql_mode = 'ANSI_QUOTES,NO_BACKSLASH_ESCAPES';
SELECT REPEAT('a',5) AS $$ FROM peg_t # $$ WHERE 0 UNION ALL SELECT v FROM peg_t
;
disconnect peg_acl;
connection default;
DROP USER peg_column_user@localhost;

DROP TABLE peg_dest;
DROP TABLE peg_i;
DROP TABLE peg_t;
--disable_query_log
SET SESSION sql_mode = @saved_sql_mode;
--enable_query_log
