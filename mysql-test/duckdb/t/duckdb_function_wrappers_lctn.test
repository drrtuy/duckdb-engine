--source ../include/have_duckdb.inc
--source include/have_lowercase1.inc

--echo #
--echo # With lower_case_table_names=1 table arguments are lowercased like
--echo # names in SQL, so they find the table and take the same metadata lock.
--echo #
CREATE TABLE T1 (id INT PRIMARY KEY) ENGINE=DuckDB;
SELECT duckdb_analyze('T1'), duckdb_analyze('TEST.T1');

--connect(con_lock, localhost, root,, test)
LOCK TABLES t1 WRITE;
--connection default
SET SESSION lock_wait_timeout= 1;
--error ER_LOCK_WAIT_TIMEOUT
SELECT duckdb_analyze('T1');
--connection con_lock
UNLOCK TABLES;
--disconnect con_lock
--connection default
DROP TABLE t1;
