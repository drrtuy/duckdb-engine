--source ../include/have_duckdb.inc

--echo #
--echo # MDEV-41383: without a TLS certificate and key the Quack listener does
--echo # not start; the engine works as before
--echo #

call mtr.add_suppression("DuckDB: the Quack listener did not start");
--let $quack_log_pattern= the Quack listener did not start: Quack: a TLS certificate and key are required
--source ../include/quack_wait_for_log.inc
SELECT VARIABLE_VALUE FROM information_schema.global_status
  WHERE VARIABLE_NAME = 'DUCKDB_QUACK_RUNNING';
CREATE TABLE t (a INT PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO t VALUES (1);
SELECT * FROM t;
DROP TABLE t;
